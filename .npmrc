# npm's arborist crashes while resolving this package's peer set ("Cannot read properties of null
# (reading 'edgesOut')" from #loadPeerSet) against vitest's peer graph. Nothing here relies on npm
# resolving peers automatically — the DSH profile supplies cordis/react/… at runtime — so the flag
# is pinned rather than passed ad hoc on every install.
legacy-peer-deps=true
